# ==============================================================================
# 11Sport IT - Docker Compose Production Environment Variables
# Sao chép file này thành .env trước khi chạy: cp .env.example .env
# ==============================================================================

# --- Ports ---
MONGO_PORT=27017
SERVER_PORT=4000
WEB_PORT=3000
CMS_PORT=3001

# --- MongoDB ---
MONGO_DB_NAME=11sport
MONGODB_URI=mongodb://mongodb:27017/11sport

# --- Server (Backend API) ---
TZ=Asia/Ho_Chi_Minh
# Tạo chuỗi ngẫu nhiên tối thiểu 32 ký tự cho production (vd: openssl rand -hex 32)
JWT_SECRET=change-me-in-production

# URL public của Web & CMS (dùng cho CORS và redirect)
WEB_URL=https://11sport-it.vercel.app
CMS_URL=https://11sport-it-m1ei.vercel.app
CORS_ORIGINS=https://11sport-it.vercel.app,https://11sport-it-m1ei.vercel.app,http://localhost:3000,http://localhost:3001

# --- OCR / Gemini Vision (tùy chọn, để trống sẽ fallback Tesseract) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Chấm công theo IP mạng Wi-Fi ---
ATTENDANCE_REQUIRE_IP=true
ATTENDANCE_ALLOWED_IPS=
ATTENDANCE_ALLOWED_IPS_2=

# --- Frontend Build Args (Web POS & CMS) ---
# Lưu ý: Trình duyệt của người dùng gọi trực tiếp URL này, cần trỏ tới domain/IP public của server
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
WEB_APP_NAME=11Sport POS & Kho
CMS_APP_NAME=11Sport CMS
