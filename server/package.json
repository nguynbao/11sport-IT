{
  "name": "11sport-server",
  "version": "1.0.0",
  "description": "11Sport POS & Inventory Management Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed:dev": "ts-node-dev --transpile-only --no-notify --exit-child src/scripts/importPdfInventory.ts && ts-node-dev --transpile-only --no-notify --exit-child src/scripts/seedDevData.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "mongodb-memory-server": "^10.1.2",
    "mongoose": "^8.8.1",
    "tesseract.js": "^5.1.1",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "ts-node-dev": "^2.0.0",
    "vitest": "^2.1.4"
  }
}
