PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/11sport
JWT_SECRET=11sport-secret-key-2026
WEB_URL=https://11sport-it.vercel.app
CMS_URL=https://11sport-it-m1ei.vercel.app
CORS_ORIGINS=https://11sport-it.vercel.app,https://11sport-it-m1ei.vercel.app,http://localhost:3000,http://localhost:3001
# OCR kiểm kho: có key -> dùng Gemini Vision (chính xác, đọc được PDF); để trống -> fallback Tesseract
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Model ưu tiên cho quét tag thực tế (nhanh nhất đứng đầu để <= 5s)
GEMINI_TAG_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-2.5-flash
# Hạn chót quét tag (ms) và thời điểm gọi model dự phòng song song (ms)
GEMINI_TAG_TIMEOUT_MS=4800
GEMINI_TAG_HEDGE_MS=2200
# (tùy chọn) các model dự phòng cho quét bảng
GEMINI_FALLBACK_MODELS=
# (tùy chọn) thời gian chờ tối đa mỗi model khi quét bảng (ms)
GEMINI_TIMEOUT_MS=20000
# Chống ngủ server (Render Free): tự ping /api/v1/health mỗi 5-10 phút (mặc định 8 phút)
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MIN=8

# Tích hợp Wise API (Máy tính quy đổi tỷ giá & chuyển tiền nhanh trên POS)
# Để trống WISE_API_TOKEN sẽ tự động dùng Wise Live Public Quote API (https://api.wise.com/v3/quotes)
WISE_API_TOKEN=
WISE_API_BASE_URL=https://api.wise.com
WISE_PROFILE_ID=

# Cấu hình Chấm công 2 Cơ sở (Location 1 đi với Mạng 1, Location 2 đi với Mạng 2 - chỉ cấu hình tại .env)
ATTENDANCE_MAX_DISTANCE_METERS=50
ATTENDANCE_REQUIRE_GPS=true
ATTENDANCE_REQUIRE_IP=false
# Ngày làm việc khối Văn phòng (0=CN, 1=T2 ... 6=T7) - mặc định T2 đến T7
ATTENDANCE_OFFICE_WORKDAYS=1,2,3,4,5,6

# --- Cơ sở 1 (Location 1 + Mạng Wi-Fi 1) ---
ATTENDANCE_OFFICE_NAME=Cơ sở 1: Showroom & Văn phòng 11Sport - 24 Tố Hữu, Hoà Cường, Đà Nẵng
ATTENDANCE_OFFICE_LAT=16.0348073
ATTENDANCE_OFFICE_LNG=108.2189159
ATTENDANCE_ALLOWED_IPS=127.0.0.1,::1,localhost,192.168.1.

# --- Cơ sở 2 (Location 2 + Mạng Wi-Fi 2) ---
ATTENDANCE_OFFICE_2_NAME=Cơ sở 2: Văn phòng 11Sport - 89 Lê Thanh Nghị, Hòa Cường, Đà Nẵng
ATTENDANCE_OFFICE_2_LAT=16.0414246
ATTENDANCE_OFFICE_2_LNG=108.2179426
ATTENDANCE_ALLOWED_IPS_2=116.110.151.140,192.168.2.207,192.168.2.,127.0.0.1,::1,localhost
